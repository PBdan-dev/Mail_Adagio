{
  "type": "object",
  "description": "Rapport .md de même forme que le tri, sans aucun changement dans Gmail.",
  "required": [
    "fichier",
    "mails_lus"
  ],
  "properties": {
    "fichier": {
      "type": "string",
      "pattern": "\\.md$",
      "description": "Rapport en Markdown écrit à format_retour.destination (absent si format_retour.type = texte)."
    },
    "mails_lus": {
      "type": "integer"
    },
    "a_verifier": {
      "type": "integer"
    },
    "par_theme": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "par_statut": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    }
  }
}
